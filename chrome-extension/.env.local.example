# chrome-extension/.env.local.example — copy to chrome-extension/.env.local
# Vite reads VITE_* vars at build time and exposes them to the bundle via import.meta.env.

# Supabase project URL + anon key (local dev uses the Supabase CLI stack)
# Source: `supabase status` in repo root, OR supabase/.env.local-devnote.md
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJ...

# ----------------------------------------------------------------------
# Phase 14 eval runner (npm run eval) — dev-only env vars.
#
# No `VITE_` prefix on purpose: Vite only inlines `VITE_*` into the
# production bundle, so these stay out of the shipped extension JS.
# ----------------------------------------------------------------------

# API key the eval runner sends as X-BYOK-Authorization to /agent-run for
# the STRONG baseline (BYOK Sonnet path). Use your own BYOK key (same as
# the one configured in the Options page).
PF_EVAL_BYOK_KEY=

# Second baseline model id (the strong one paired with gpt-4o-mini).
# Default = canonical Phase 12 D-B2 local-litellm wrapper id.
# Override if testing a different provider/model combo.
PF_EVAL_BYOK_MODEL=claude-sonnet-4-5-20250929

# C-1 (cross-AI review iter 2): API key the eval runner sends as
# X-BYOK-Authorization to /agent-run for the WEAK baseline (gpt-4o-mini
# routed via api.openai.com). DISTINCT from OPENAI_API_KEY (which feeds
# the GPT-4o judge). Set to your OpenAI API key.
#
# If unset, the runner SKIPS the gpt-4o-mini half + warns; it does NOT
# throw. This lets you run BYOK-only or weak-only smoke without forcing
# both keys to be present.
PF_EVAL_OPENAI_KEY=

# iter-4 hotfix: support OpenAI-compat proxies (e.g. newapi/openrouter)
# for the WEAK baseline. Default = api.openai.com/v1.
# Useful when your PF_EVAL_OPENAI_KEY is for a proxy not direct OpenAI.
# (Note: proxy must have a `gpt-4o-mini` channel for the weak baseline
# to land — otherwise the request 503s with model_not_found.)
PF_EVAL_OPENAI_BASE_URL=https://api.openai.com/v1

# iter-4 hotfix: explicit baseURL for STRONG baseline (BYOK).
# The Edge Function passes body.baseURL to byok-passthrough.ts; without
# this, the BYOK key is sent to the managed-AI default endpoint and
# authn fails. Required if PF_EVAL_BYOK_KEY is set and the BYOK provider
# is anything other than the default ai-proxy.
# Example: https://newapi.magicneko.com/v1
PF_EVAL_BYOK_BASE_URL=

# v1.2.x A4 follow-up: judge model override. judge.ts defaults to gpt-4o
# (D-B3) but the proxy may not have that channel — set whatever model
# your PF_EVAL_OPENAI_KEY can call. gpt-5.2-chat / gpt-5.4 / claude-haiku-*
# are good cheap chat-tuned alternatives for newapi.magicneko.com users.
PF_EVAL_JUDGE_MODEL=gpt-4o
