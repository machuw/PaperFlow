{
  "name": "paperflow-extension",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:dev": "vite build --mode development && vite build --config vite.content.config.ts --mode development",
    "dev": "vite build --watch & vite build --config vite.content.config.ts --watch",
    "dev:local": "vite build --mode development --watch & vite build --config vite.content.config.ts --mode development --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && node ../scripts/verify-reader.mjs",
    "release": "bash scripts/release.sh",
    "bump": "node scripts/bump.mjs",
    "eval": "tsx tests/eval/runner.ts",
    "eval:dry": "tsx tests/eval/runner.ts --dry-run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.36",
    "@floating-ui/react-dom": "^2.1.8",
    "@supabase/supabase-js": "^2.104.1",
    "@xyflow/react": "^12.10.2",
    "ai": "5.0.179",
    "dagre": "^0.8.5",
    "pdfjs-dist": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.260",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.6.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/ui": "^1.0.0",
    "jose": "^5.10.0",
    "jsdom": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
