# supabase/.env.example — copy to supabase/.env for local dev; set real values in
# Supabase Dashboard → Project Settings → Edge Functions → Secrets for production.

# ─── OpenAI (managed AI proxy) ─────────────────────────────────────────────
# Source: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional split for chat/explain (FAST_KINDS) — when unset, falls back to
# OPENAI_MODEL above. Use a faster/cheaper model here for high-volume kinds
# while keeping summarize/translate/overview/keyword on the heavier default.
OPENAI_MODEL_FAST=gpt-4o-mini

# ─── newapi (Phase 15 managed-models upstream) ─────────────────────────────
# Source: user-provided OpenAI-compat upstream forwarding service. Used by
# ai-proxy when body.model resolves to a MANAGED_MODELS entry with
# provider='newapi' (e.g. claude-opus-4-7). Optional: when unset, ai-proxy
# returns 500 reason='managed-provider-misconfigured' for managed requests
# but the OpenAI fallback path (no body.model) continues to work.
NEWAPI_BASE_URL=https://your-newapi-host.example/v1
NEWAPI_API_KEY=sk-newapi-...

# ─── Stripe (subscription billing) ─────────────────────────────────────────
# Source: Stripe Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SYNC=price_...
STRIPE_PRICE_PRO=price_...

# ─── Supabase service role (for Edge Functions to bypass RLS) ──────────────
# Source: `supabase start` output OR Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Public URL for Stripe return + UpgradePrompt upgrade CTA ──────────────
# These point at the eventual production billing host. For local dev they can
# point anywhere (Stripe-test-mode redirects don't need to actually resolve).
UPGRADE_URL=https://paperflow.app/pricing
STRIPE_PORTAL_RETURN_URL=https://paperflow.app/billing
STRIPE_SUCCESS_URL=https://paperflow.app/billing/success
STRIPE_CANCEL_URL=https://paperflow.app/billing/cancel

# ─── Google OAuth (LoginModal "Sign in with Google" button) ────────────────
# Source: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (type = Web application). Authorized redirect URI on Google's
# side must be http://127.0.0.1:54321/auth/v1/callback for local dev.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-...

# ─── Agent Runtime (Phase 10) ──────────────────────────────────────────────
# Optional: override the default 10-step ceiling. Manual counter inside
# supabase/functions/agent-run/index.ts uses this value; SDK stopWhen also
# reads it as belt-and-suspenders defense (CONTEXT.md D-04).
AGENT_RUN_MAX_STEPS=10

# ─── Supabase Auth JWT secret (e2e fixture HS256 sign, Phase 24) ──────────
# Source: `supabase status -o env` output (local supabase default; never
# changes unless you customize supabase/config.toml [auth] jwt_secret).
# Consumed by chrome-extension/tests/e2e/_jwt-fixture.ts only — production
# Edge Functions get this same secret via Supabase Auth gateway.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
